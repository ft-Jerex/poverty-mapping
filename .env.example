# Flask Configuration
FLASK_SECRET_KEY=your-random-secret-key-here-replace-in-production
FLASK_ENV=development

# Google Earth Engine Service Account (for data updates)
# Option 1: Path to JSON file
# GEE_CREDENTIALS_PATH=/path/to/gee-service-account.json

# Option 2: Direct JSON content (more secure for deployment)
# GEE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Earth Engine Project
GEE_PROJECT_ID=ee-zc-povertymapping

# Application Settings
APP_PORT=8000
APP_HOST=0.0.0.0

# Database
DATABASE_PATH=/app/data/users.db