# Production Environment Configuration
# Copy this to .env.production and fill in your values

# Flask Configuration (REQUIRED)
FLASK_SECRET_KEY=generate-a-strong-random-key-here-64-chars-minimum
FLASK_ENV=production

# Google Earth Engine (env-only; no secret files)
GEE_PROJECT_ID=ee-zc-povertymapping
GEE_SERVICE_ACCOUNT=povertymapping@ee-zc-povertymapping.iam.gserviceaccount.com
# Preferred: base64-encoded full JSON of the service account key
GEE_PRIVATE_KEY_
# Fallback: raw JSON on one line with \n in private_key (leave empty if using B64)
GEE_PRIVATE_KEY_JSON=

# DigitalOcean BucketKey
BUCKET_CDN_ORIGIN_ENDPOINT=https://sentgeotif.sgp1.digitaloceanspaces.com
BUCKET_ACCESS_KEY=DO00WRGTFT94FHB732PF
BUCKET_PRIVATE_KEY=ZcDWLM2JimOKyYBpcCmnBbylek6vL5H9QVM6vLOubw0

# Application Settings
APP_PORT=8000
APP_HOST=0.0.0.0

# Database
DATABASE_PATH=/app/data/users.db

